# Vyuu MCP Gateway — secrets template.
#
# Replace `CHANGEME` placeholders before applying. Rotate via
# external-secrets-operator / Vault / sealed-secrets in production.
#
# Apply with:
#   cp secret.yaml.example secret.yaml
#   # edit values
#   kubectl apply -f secret.yaml
#
# DO NOT commit `secret.yaml` (note: this file's `.example` suffix
# keeps it out of accidental commits — the real one would be
# generated by your secret-management tool).
apiVersion: v1
kind: Secret
metadata:
  name: vyuu-gateway-secrets
  namespace: vyuu
type: Opaque
stringData:
  # ---- Backing services ----------------------------------------------------
  # Postgres connection. The K8s `postgres` Service should resolve to
  # the cluster's Postgres tier (managed CloudSQL / RDS / on-prem
  # Patroni). Avoid using `postgres-postgresql.vyuu.svc` for prod —
  # that puts critical state on the same K8s cluster as the gateway.
  VYUU_DATABASE_URL: postgresql+psycopg://vyuu:CHANGEME@postgres.internal:5432/vyuu_gateway

  VYUU_REDIS_URL: redis://redis.internal:6379/0

  # NATS JetStream — audit producer target. Production deployments
  # wire `audit_emitter=AsyncAuditEmitter(NATSProducer(...))` at app
  # construction; this URL is consumed by that wiring layer.
  VYUU_NATS_URL: nats://nats.internal:4222

  # ---- Signing secrets ---------------------------------------------------
  # Operator-console HMAC test-token signing. Production swaps the
  # `FakeOperatorAuthProvider` for a real OIDC backend; until then,
  # set a long random string here.
  VYUU_OPERATOR_AUTH_SIGNING_SECRET: CHANGEME-long-random-string

  # Portal session signing — mints browser-session JWTs after
  # password / OIDC login.
  VYUU_PORTAL_SESSION_SIGNING_SECRET: CHANGEME-long-random-string

  # ---- OIDC providers (optional) -----------------------------------------
  # Wire whichever the deployment uses. Leave unset to disable.
  # VYUU_OIDC_MICROSOFT_TENANT_ID: CHANGEME
  # VYUU_OIDC_MICROSOFT_CLIENT_ID: CHANGEME
  # VYUU_OIDC_MICROSOFT_CLIENT_SECRET: CHANGEME
  # VYUU_OIDC_GOOGLE_CLIENT_ID: CHANGEME
  # VYUU_OIDC_GOOGLE_CLIENT_SECRET: CHANGEME
