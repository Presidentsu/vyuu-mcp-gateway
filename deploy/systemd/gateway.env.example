# Vyuu MCP Gateway — environment file template.
#
# Install at /etc/vyuu/gateway.env (chmod 0600, chown root:vyuu).
# Reload service after changes: `sudo systemctl restart vyuu-gateway`.

# ====================== Connection strings ===================================
# Postgres URL — gateway config DB.
VYUU_DATABASE_URL=postgresql+psycopg://vyuu:CHANGEME@127.0.0.1:5432/vyuu_gateway

# Redis URL — multi-instance session registry. REQUIRED if running
# >1 gateway worker (the default --workers in the systemd unit is 4,
# so this is required in practice). Sessions are sticky to a worker
# pod via this registry; without it, MCP streamable-http session ids
# fail to route after the load balancer.
VYUU_REDIS_URL=redis://127.0.0.1:6379/0

# NATS JetStream URL — audit producer target.
VYUU_NATS_URL=nats://127.0.0.1:4222

# ====================== uvicorn worker tuning ================================
# Worker count — set to (cpu_count - 4) capped at 16 in practice.
# Each worker is single-event-loop async; more workers = more
# parallel CPU but more shared DB/Redis pool slots used.
VYUU_WORKERS=4

# Inbound back-pressure (Tier-1 stress-test fix). Past this cap a
# new request gets a fast 503 instead of queueing forever.
VYUU_INBOUND_LIMIT_CONCURRENCY=200

# Worker recycle count. Defends against slow leaks; workers gracefully
# restart after this many requests.
VYUU_INBOUND_LIMIT_MAX_REQUESTS=10000

# Kernel accept-queue depth.
VYUU_INBOUND_BACKLOG=128

# Idle keep-alive timeout (seconds). Closing idle conns sooner
# returns FDs faster under burst.
VYUU_INBOUND_KEEP_ALIVE_SECONDS=5

# Per-tenant inflight semaphore. Prevents one tenant's runaway
# agent from starving every other tenant on the same gateway pod.
VYUU_INBOUND_PER_TENANT_INFLIGHT_LIMIT=64

# ====================== DB connection pool ==================================
# Sized to feed the inflight gate. Each gateway worker has its own
# pool; total connections to Postgres = workers × (pool_size + max_overflow).
# Tune Postgres `max_connections` accordingly.
VYUU_DB_POOL_SIZE=20
VYUU_DB_POOL_MAX_OVERFLOW=40
VYUU_DB_POOL_TIMEOUT_SECONDS=10
VYUU_DB_POOL_RECYCLE_SECONDS=1800

# ====================== Audit storage cap ===================================
# Per-payload cap for opted-in raw-args / raw-response capture in the
# audit event. Transit is NEVER blocked by this — a 50 MB upstream
# response still flows through to the client. Only the audit storage
# sentinel records it as "X bytes through, 0 stored due to cap."
VYUU_AUDIT_RAW_CAPTURE_BYTE_CAP=10485760

# ====================== Auto-sync on registration ===========================
# Trigger a one-shot capability sync after a successful server
# registration so tool calls don't fail with `capabilities_not_synced`
# until the operator clicks Sync. Disable if a separate orchestrator
# drives sync.
VYUU_AUTO_SYNC_CAPABILITIES_ON_REGISTRATION=true
VYUU_AUTO_SYNC_PER_CALL_TIMEOUT_SECONDS=30

# ====================== Operator auth =======================================
# HMAC signing secret for the operator-console test-token path. In
# production you'd swap this for a real OperatorAuthProvider (OIDC,
# external IdP). Until then, set a long random string.
VYUU_OPERATOR_AUTH_SIGNING_SECRET=please-replace-with-a-long-random-string

# Portal session signing secret — used to mint browser-session JWTs
# after a successful portal login (local password OR OIDC).
VYUU_PORTAL_SESSION_SIGNING_SECRET=please-replace-with-a-long-random-string
VYUU_PORTAL_SESSION_TTL_SECONDS=43200

# ====================== Operational =========================================
VYUU_ENVIRONMENT=production
VYUU_LOG_LEVEL=INFO
VYUU_VERSION=v1.0.0

# ---- SIEM-1 · deployment-level SIEM export (Splunk HEC), optional ----------
#VYUU_SIEM_HEC_URL=https://splunk.corp:8088
#VYUU_SIEM_HEC_TOKEN=<hec-token>
#VYUU_SIEM_HEC_INDEX=vyuu
#VYUU_SIEM_CATEGORIES=["tool_call","access_attempt","admin_action","auth","tool_auth"]
#VYUU_SIEM_LOG_LEVEL=WARNING

# ---- OTEL-1 · OpenTelemetry → Splunk OTel Collector, optional --------------
# pip install vyuu-mcp-gateway[otel]
#VYUU_OTEL_ENABLED=true
#VYUU_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#VYUU_OTEL_TRACES_SAMPLE_RATIO=1.0
