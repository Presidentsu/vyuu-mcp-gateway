# Secure MCP Gateway — local development environment.
# Copy to `.env` (git-ignored). Every variable is read by `vyuu_gateway/config.py`
# (pydantic-settings, prefix VYUU_). See docs/DEPLOYMENT.md for the full reference.

# --- Core ---------------------------------------------------------------------
VYUU_ENVIRONMENT=local
VYUU_LOG_LEVEL=INFO
VYUU_DATABASE_URL=postgresql+psycopg://vyuu@127.0.0.1:5432/vyuu_gateway
# Single-tenant mode: the login pages auto-resolve this tenant (no UUID paste).
VYUU_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
# Recorded on every audit event; set per instance in production.
VYUU_GATEWAY_INSTANCE_ID=gateway-local

# --- Signing secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") --
VYUU_OPERATOR_AUTH_SIGNING_SECRET=change-me-32-plus-random-bytes
VYUU_PORTAL_SESSION_SIGNING_SECRET=change-me-32-plus-random-bytes

# --- Inbound identity: `fake` (lab headers) or `api_key` (production) ------------
VYUU_INBOUND_IDENTITY_PROVIDER=api_key

# --- Secret store: memory | vault | aws_secrets_manager | kubernetes ----------------
VYUU_SECRET_STORE_BACKEND=memory
# VYUU_VAULT_ADDR=https://vault.example:8200
# VYUU_VAULT_TOKEN=
# VYUU_AWS_REGION=us-east-1

# --- Optional infrastructure -----------------------------------------------------
# VYUU_REDIS_URL=redis://127.0.0.1:6379/0          # multi-instance sessions
# VYUU_CAPABILITY_SYNC_ENABLED=true                 # periodic upstream drift detection
# VYUU_TOOL_CALL_EVENT_RETENTION_DAYS=90            # 0 = keep forever
# VYUU_ADMIN_AUDIT_RETENTION_DAYS=365

# --- SIEM export (deployment-level Splunk HEC target; tenants configure their own in the console) --
# VYUU_SIEM_HEC_URL=https://splunk.example:8088
# VYUU_SIEM_HEC_TOKEN=
# VYUU_SIEM_HEC_INDEX=vyuu
# VYUU_SIEM_CATEGORIES=["tool_call","access_attempt","admin_action","auth","tool_auth"]

# --- OpenTelemetry (traces + metrics to the Splunk OTel Collector; needs pip install ".[otel]") --
# VYUU_OTEL_ENABLED=true
# VYUU_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# VYUU_OTEL_TRACES_SAMPLE_RATIO=1.0
